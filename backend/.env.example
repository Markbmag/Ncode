# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored - NEVER commit it.
#
# You do NOT need this file to add databases: admins can connect them from the web UI
# ("Add a database"). Use .env only if you prefer to define connections in a file; those
# show a lock icon in the UI and can only be edited here.
#
# Each connection is a group of NCODE_CONN_<KEY>_* variables. <KEY> becomes the
# connection id in the API (lowercase). Quote passwords that contain # or $ with
# single quotes. Special characters like ( ) @ / are fine as-is.
#
# TIP: use a database account that only has SELECT rights.

# --- Example 1: MySQL ---------------------------------------------------------
NCODE_CONN_MES_ENGINE=mysql
NCODE_CONN_MES_LABEL=MES
NCODE_CONN_MES_HOST=10.0.0.10
NCODE_CONN_MES_PORT=3306
NCODE_CONN_MES_USER=readonly_user
NCODE_CONN_MES_PASSWORD='change-me'
NCODE_CONN_MES_DATABASE=my_database
# Column-name fragments that identify a record (shown as a badge in results):
NCODE_CONN_MES_ID_HINTS=vin

# --- Example 2: PostgreSQL (uncomment to use) ---------------------------------
# NCODE_CONN_PG_ENGINE=postgresql
# NCODE_CONN_PG_LABEL=Analytics
# NCODE_CONN_PG_HOST=10.0.0.20
# NCODE_CONN_PG_USER=readonly_user
# NCODE_CONN_PG_PASSWORD='change-me'
# NCODE_CONN_PG_DATABASE=analytics
# NCODE_CONN_PG_SCHEMA=public

# --- Example 3: SQL Server ----------------------------------------------------
# NCODE_CONN_SQL_ENGINE=mssql
# NCODE_CONN_SQL_HOST=10.0.0.30
# NCODE_CONN_SQL_USER=readonly_user
# NCODE_CONN_SQL_PASSWORD='change-me'
# NCODE_CONN_SQL_DATABASE=erp
# NCODE_CONN_SQL_SCHEMA=dbo

# --- Example 4: SQLite (path to the file) -------------------------------------
# NCODE_CONN_LOCAL_ENGINE=sqlite
# NCODE_CONN_LOCAL_DATABASE=/path/to/file.db

# --- Login / team settings (all optional) -------------------------------------
# Users are managed with:  python -m app.manage create-user <name> [--admin]
# NCODE_AUTH_ENABLED=true               # keep true on any shared network!
# NCODE_SESSION_TTL_HOURS=12            # how long a login lasts
# NCODE_MAX_CONCURRENT_SEARCHES=3       # running searches per user
# NCODE_LOGIN_MAX_FAILURES=5            # wrong passwords before a temporary lock
# NCODE_LOGIN_LOCK_SEC=300
# NCODE_APP_DB=                         # users/audit database (default backend/data/ncode.sqlite)
# NCODE_SECRET_KEY=                     # encrypts passwords saved from the UI. Empty = a key file is
#                                       # created at backend/data/secret.key. Make one yourself with:
#                                       #   python -m app.manage generate-key

# --- Server settings (all optional) -------------------------------------------
# NCODE_HOST=127.0.0.1                  # use 0.0.0.0 only on a trusted network!
# NCODE_PORT=8000
# NCODE_CORS_ORIGINS=http://localhost:5173
# NCODE_SEARCH_WORKERS=8                # tables searched in parallel
# NCODE_STATEMENT_TIMEOUT_SEC=20        # per-query limit
# NCODE_DEFAULT_ROW_LIMIT=10            # rows per table
# NCODE_MAX_ROW_LIMIT=200
# NCODE_MAX_TOTAL_RESULTS=1000
# NCODE_MAX_EXPORT_ROWS=50000          # rows in one CSV export from the table view
# NCODE_READ_ONLY_SESSIONS=true         # ask the DB to refuse writes

# --- Questions and SQL mode ---
# NCODE_QUERY_DEFAULT_ROWS=2000        # rows returned when a question does not set a limit
# NCODE_QUERY_MAX_ROWS=10000           # hard cap per question / SQL query
# NCODE_QUERY_CACHE_TTL_SEC=60         # reuse identical results for this long; 0 = no cache
# NCODE_MAX_CONCURRENT_QUERIES=3       # running questions per user
# NCODE_QUERY_WORKERS=8                # questions running at once on the server
# NCODE_DB_POOL_SIZE=0                 # connections kept open per database; 0 = the larger of the two worker counts
# NCODE_DB_POOL_OVERFLOW=4             # extra connections per database for a burst (queries + search + browse at once)

# --- Multi-source questions and uploaded files ---
# NCODE_FEDERATION_SOURCE_ROWS=100000  # rows read from each source of a multi-source question
# NCODE_FEDERATION_MEMORY_MB=512       # DuckDB memory per multi-source run
# NCODE_FEDERATION_THREADS=2           # DuckDB threads per multi-source run
# NCODE_UPLOADS_ENABLED=true           # users may upload CSV / Excel / Parquet files
# NCODE_DATASET_MAX_MB=100             # largest file that can be uploaded
# NCODE_DATASET_MAX_ROWS=1000000       # rows kept per uploaded file (bigger files are refused)
# NCODE_PROFILE_SAMPLE_ROWS=20000      # rows read to profile or X-ray a table (the cost guard)

# --- Subscriptions, alerts and public links (M8) ---
# The email server, Slack/Teams/Telegram destinations, the site address and sharing are set
# in the app: Admin → Delivery and Admin → Sharing (secrets are stored encrypted).
# NCODE_SCHEDULER_ENABLED=true         # false: nothing is sent on schedule ("Send now" still works)
# NCODE_SCHEDULER_INTERVAL_SEC=30      # how often due subscriptions are looked for
# NCODE_SCHEDULER_WORKERS=2            # subscriptions sent at the same time
# NCODE_SLOW_QUERY_SEC=5               # slower queries are listed in Admin → Usage
# NCODE_PUBLIC_RATE_PER_MIN=120        # requests per minute per visitor of a public link / embed

# --- Operations (M9) ---
# NCODE_BACKUP_HOUR=2                  # automatic daily backup at this hour (server time); -1 = off
# NCODE_BACKUP_KEEP=7                  # automatic backups kept in data/backups
# NCODE_AUDIT_KEEP_DAYS=365            # audit log entries older than this are removed (daily); 0 = keep forever
# NCODE_METRICS_TOKEN=                 # lets Prometheus read /metrics with "Authorization: Bearer <token>"

# --- First steps (M11) ---
# NCODE_DEMO=true                      # the "Factory demo" database: a small car plant (lines, shifts, work orders,
#                                      # downtime, scrap, VINs) to try Ncode on. Created on the first start in
#                                      # data/demo/factory.sqlite; everyone may use it. Admin → Databases can hide
#                                      # it for everyone; false: it is not created at all.
# NCODE_DEMO_LANGUAGE=en               # names of the demo's example collection, questions and dashboard: en or ru
